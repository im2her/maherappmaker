# CORE_TOKEN: Required for the Maher Core engine (Gemini API Key).
# This token is injected automatically at runtime. (e.g. AIzaSy...)
CORE_TOKEN="YOUR_CORE_TOKEN"

# APP_URL: The URL where this platform is hosted.
# This is injected automatically at runtime.
APP_URL="YOUR_APP_URL"

# MYFATOORAH_API_KEY: Replace with your actual MyFatoorah payment API key for processing payments
MYFATOORAH_API_KEY="YOUR_MYFATOORAH_API_KEY"
